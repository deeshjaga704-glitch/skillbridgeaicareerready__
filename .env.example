# Google Gemini API key (PRIMARY - get yours free at https://aistudio.google.com/apikey)
GEMINI_API_KEY=your_api_key_here

# Optional: override the default model (default: gemini-1.5-flash)
GEMINI_MODEL=gemini-2.5-flash

# Lovable AI Gateway key (FALLBACK - only needed when deployed via Lovable)
LOVABLE_API_KEY=
